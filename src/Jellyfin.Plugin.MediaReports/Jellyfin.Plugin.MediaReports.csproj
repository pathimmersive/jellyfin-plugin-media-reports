<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.MediaReports</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The server provides these at runtime; never ship them in the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.*" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.*" ExcludeAssets="runtime" />
    <!-- The server loads its own SQLite; the plugin ships neither the library nor native binaries. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.MediaReports.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Report button script runs in jellyfin-web and is served at /MediaReports/web/reporter.js. -->
    <EmbeddedResource Include="Web/reporter.js" LogicalName="reporter.js" />
  </ItemGroup>

  <ItemGroup>
    <None Include="meta.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
